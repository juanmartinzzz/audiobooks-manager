# Cloudflare credentials — add later, do not commit the real .env
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# VITE_API_URL=https://audiobooks-manager-api.<subdomain>.workers.dev
#
# Shared API password for local Vite (seeds Settings on this device).
# Production Worker uses the Wrangler secret APP_PASSWORD — do not add a VITE_ prefix.
# APP_PASSWORD=
#
# Local Worker: copy api/.dev.vars.example to api/.dev.vars
# Production: npm run with-env -- npm exec -- wrangler secret put APP_PASSWORD -c api/wrangler.jsonc
