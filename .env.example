# Cloudflare credentials — add later, do not commit the real .env
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# VITE_API_URL=https://audiobooks-manager-api.<subdomain>.workers.dev
#
# API password is a Wrangler secret named APP_PASSWORD (not a VITE_ var).
# Local: copy api/.dev.vars.example to api/.dev.vars
# Production: npm run with-env -- npm exec -- wrangler secret put APP_PASSWORD -c api/wrangler.jsonc
