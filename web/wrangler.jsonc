{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "audiobooks-manager-web",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
